  {
   "id": "fluid-gel",
   "term": "fluid gel",
   "aliases": [],
   "def": "A liquid that carries a weak, invisible gel structure. It pours like a liquid but stops suspended particles from sinking."
  },
  {
   "id": "gellan-gum",
   "term": "gellan gum",
   "aliases": [],
   "def": "A gel-forming hydrocolloid that the Associated Press named as the material of the Orbitz spheres."
  },
  {
   "id": "yield-stress",
   "term": "yield stress",
   "aliases": [],
   "def": "The smallest force a gel-like liquid needs before it starts to flow. Below it, particles held in the liquid stay where they are."
  },
  {
